{
  "name": "@foadonis/lucidity",
  "version": "0.0.1-next.0",
  "description": "Quality of life improvements for the Lucid ORM",
  "keywords": [
    "adonis",
    "adonisjs",
    "lucid",
    "typescript"
  ],
  "homepage": "https://friendsofadonis.com/docs/lucidity",
  "bugs": {
    "url": "https://github.com/FriendsOfAdonis/FriendsOfAdonis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Martin Paucot",
    "email": "contact@martin-paucot.fr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FriendsOfAdonis/FriendsOfAdonis",
    "directory": "packages/lucidity"
  },
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./filter": "./build/modules/filter/main.js",
    "./polymorphic": "./build/modules/polymorphic/main.js",
    "./soft_delete": "./build/modules/soft_delete/main.js",
    "./types": "./build/src/types.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "del-cli build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "test": "c8 yarn quick:test",
    "build": "yarn clean && tsc",
    "dev": "tsc --watch",
    "version": "yarn build",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@adonisjs/core": "catalog:",
    "@adonisjs/lucid": "catalog:",
    "@japa/assert": "^4.2.0",
    "@japa/expect": "^3.0.7",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^4.0.0",
    "@swc/core": "1.15.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "catalog:",
    "better-sqlite3": "^11.9.1",
    "c8": "^10.1.3",
    "del-cli": "^7.0.0",
    "luxon": "^3.7.2",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "youch": "catalog:"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "luxon": "^3.5.0"
  },
  "c8": {
    "exclude": [
      "tests/**"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
