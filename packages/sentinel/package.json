{
  "name": "@foadonis/sentinel",
  "version": "0.0.0",
  "description": "Authentication building blocks for AdonisJS: email verification, password management and magic links",
  "keywords": [
    "adonis",
    "adonisjs",
    "authentication",
    "email-verification",
    "magic-link",
    "password-reset",
    "typescript"
  ],
  "homepage": "https://friendsofadonis.com/docs/sentinel",
  "bugs": {
    "url": "https://github.com/FriendsOfAdonis/FriendsOfAdonis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Martin Paucot",
    "email": "contact@martin-paucot.fr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FriendsOfAdonis/FriendsOfAdonis",
    "directory": "packages/sentinel"
  },
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./sentinel_provider": "./build/providers/sentinel_provider.js",
    "./services/tokens": "./build/services/tokens.js",
    "./services/otp": "./build/services/otp.js",
    "./services/totp": "./build/services/totp.js",
    "./services/magic_link": "./build/services/magic_link.js",
    "./services/password": "./build/services/password.js",
    "./services/email": "./build/services/email.js",
    "./factories/*": "./build/factories/*.js",
    "./types": "./build/src/types.js",
    "./token": "./build/modules/token/main.js",
    "./otp": "./build/modules/otp/main.js",
    "./totp": "./build/modules/totp/main.js",
    "./magic_link": "./build/modules/magic_link/main.js",
    "./password": "./build/modules/password/main.js",
    "./email": "./build/modules/email/main.js",
    "./errors": "./build/src/errors.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "cpy \"stubs/**/*.stub\" build/stubs",
    "index:commands": "adonis-kit index build/commands",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "test": "c8 yarn quick:test",
    "build": "yarn clean && tsc && yarn copy:templates && yarn index:commands",
    "dev": "tsc --watch",
    "version": "yarn build"
  },
  "devDependencies": {
    "@adonisjs/core": "catalog:",
    "@adonisjs/lucid": "catalog:",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^4.5.0",
    "@swc/core": "1.15.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.5.0",
    "c8": "^11.0.0",
    "cpy-cli": "^7.0.0",
    "del-cli": "^7.0.0",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "timekeeper": "^2.3.1",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "youch": "catalog:"
  },
  "dependencies": {
    "otpauth": "^9.5.1"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "luxon": "^3.5.0",
    "qrcode": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "c8": {
    "exclude": [
      "tests/**"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "engines": {
    "node": ">=20.15.0"
  }
}
